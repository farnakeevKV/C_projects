{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build active C file",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}

